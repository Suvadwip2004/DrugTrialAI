# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
*json
# ---- uv ----
# uv creates a local venv (.venv) and a lockfile (uv.lock).
# Keep uv.lock committed (reproducible builds) — do NOT ignore it.
# Only ignore uv's cache, not the lockfile itself.
.uv/
.uv_cache/

# ---- Environment variables / secrets ----
.env
.env.*
!.env.example

# ---- Distribution / packaging ----
build/
dist/
*.egg-info/
*.egg

# ---- Testing / coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Databases (local dev) ----
*.sqlite3
*.db

# ---- Logs ----
*.log
logs/

# ---- Docker ----
*.pid

